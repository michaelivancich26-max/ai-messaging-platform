# Credentials match docker-compose.yml (aiuser / aipassword / ai_messaging).
DATABASE_URL="postgresql://aiuser:aipassword@localhost:5432/ai_messaging"
REDIS_URL="redis://localhost:6379"
ANTHROPIC_API_KEY="sk-ant-..."
PORT=3001

# Origin allowed through CORS. Optional locally — defaults to http://localhost:3000.
# Set this in production to the deployed client URL.
CLIENT_URL="http://localhost:3000"

# REQUIRED. Must be byte-identical to the client's NEXTAUTH_SECRET
# (client/.env.local locally; the Vercel environment variable in production).
#
# NextAuth issues the session token; this server derives the same encryption key
# from this secret to open it and learn who is calling. It is the only thing
# standing between a request and acting as any user it names, so the server
# refuses to boot without it rather than falling back to trusting the caller.
#
# If the two sides ever hold different values, no token verifies and every
# request 401s — the site reads as permanently signed out.
NEXTAUTH_SECRET=""

# ── Stripe (Grounds Pro subscriptions, via Managed Payments) ────────────────
# Unset -> billing endpoints return 503 and the app runs on the free tier (Pro can
# still be granted via the admin toggle). Use TEST-mode keys while developing.
# Checkout uses Stripe MANAGED PAYMENTS (Stripe handles payment methods + tax) on the
# preview API version 2026-02-25.preview — enable Managed Payments on your account.
#   STRIPE_SECRET_KEY     — REQUIRED to turn billing on. sk_test_... (sk_live_... in prod).
#   STRIPE_PRICE_ID       — OPTIONAL. A recurring Price id (price_...). If unset, a
#                           "Grounds Pro" product + $10/mo price (tax code txcd_10103100)
#                           are created on first checkout and cached.
#   STRIPE_WEBHOOK_SECRET — whsec_... from the webhook you register at
#                           <server-url>/api/stripe/webhook. Events:
#                           checkout.session.completed,
#                           customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Which judge decides a ranked 1v1: "shadow" (model decides, rubric recorded
# alongside for comparison) or "rubric" (claim scores decide, model writes the
# sentence). Defaults to shadow. Flip only once /api/admin/judge-shadow shows
# high agreement — and check that disagreements cluster on thin margins.
RANKED_JUDGE="shadow"
